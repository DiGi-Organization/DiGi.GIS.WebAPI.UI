@{
    ViewData["Title"] = "Administrative Areas";
    ViewData["Description"] = "Browse and query administrative boundaries including Voivodeships, Counties, and Municipalities from the GIS database.";
}

<div class="gis-panel">
    <div class="gis-card gis-card-narrow">
        <h2 class="gis-title">Administrative Areas</h2>

        <div class="gis-form-row">
            <select id="typeSelect" class="gis-select">
                <option value="Voivodeship">Voivodeship</option>
                <option value="County">County</option>
                <option value="Municipality">Municipality</option>
            </select>

            <button id="loadItemsBtn" class="gis-button">
                <span>Load Items</span>
            </button>
        </div>

        <div id="loading" style="display:none;">
            <div class="gis-loader"></div>
            <p class="gis-loader-text">Fetching data from database...</p>
        </div>
    </div>

    <div id="tableContainer" class="gis-results-container">
    </div>
</div>

@section Scripts {
    <script src="~/js/gis-common.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btn = document.getElementById('loadItemsBtn');
            
            if(btn) {
                btn.addEventListener('click', async function() {
                    const type = document.getElementById('typeSelect').value;
                    const container = document.getElementById('tableContainer');
                    const loader = document.getElementById('loading');

                    // UI State
                    btn.disabled = true;
                    loader.style.display = 'block';
                    container.innerHTML = '';

                    try {
                        const baseUrl = window.AppBaseUrl || '/';
                        const cleanBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
                        const response = await fetch(`${cleanBase}/administrativeareal2D/administrativeareal2Dreferencesbyadministrativearealtype?administrativearealtype=${type}&uniquecode=true`);
        
                        if (!response.ok) throw new Error('Communication error with Web API');

                        const htmlResult = await response.text();
                        container.innerHTML = htmlResult;

                        // Initialize the reveal-more pager (shared with Building2D, gis-common.js).
                        // The partial hides the rows beyond its own `initialLimit`; here we simply read
                        // how many rows are actually visible so the threshold stays a single source of truth
                        // in _AdministrativeAreal2DReferences.cshtml.
                        const totalRows = container.querySelectorAll('#adminArealTable tbody tr').length;
                        const visibleRows = Array.from(container.querySelectorAll('#adminArealTable tbody tr:not(.row-hidden)'));
                        initTablePager(visibleRows.length, totalRows, {
                            tableSelector: '#adminArealTable',
                            onRowsRevealed: function (rows) {
                                // Extend the coverage request to the newly revealed rows only.
                                const revealedIds = collectCoverageIds(rows);
                                if (revealedIds.length > 0) loadAllOrtoCoverages(revealedIds);
                            }
                        });

                        // Orto coverage is requested only for the rows currently visible.
                        const visibleIds = collectCoverageIds(visibleRows);
                        if (visibleIds.length > 0) {
                            await loadAllOrtoCoverages(visibleIds);
                        }

                    } catch (error) {
                        console.error('API Error:', error);
                        alert("Error: " + error.message);
                    }
                    finally {
                        // UI State - End loading (ALWAYS executes)
                        btn.disabled = false;
                        loader.style.display = 'none';
                    }
                });
            }
        });
    </script>
}
