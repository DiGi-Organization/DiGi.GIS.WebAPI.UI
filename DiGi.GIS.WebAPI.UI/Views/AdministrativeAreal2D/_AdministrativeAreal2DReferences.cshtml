@using DiGi.GIS.Classes
@using System.Linq
@using DiGi.GIS.PostgreSQL.Classes
@using DiGi.GIS.PostgreSQL.Enums

@{
    // Logic for data preparation
    List<AdministrativeAreal2DReference>? administrativeAreal2DReferences = (Model as IEnumerable<AdministrativeAreal2DReference>)?.ToList();
    
    if (administrativeAreal2DReferences is null)
    {
        administrativeAreal2DReferences = [];
    }

    administrativeAreal2DReferences = administrativeAreal2DReferences
        .GroupBy(area => area.Code)
        .Select(group => group.First())
        .OrderBy(area => area.Name)
        .ToList();

    // Paging threshold: result sets with more than this many items use the reveal-more pager
    // (rows beyond the limit start hidden and are revealed with the +100 / All buttons).
    int initialLimit = 500;
}

<div class="gis-table-container margin-large">
    @if (administrativeAreal2DReferences.Count > initialLimit)
    {
        <div class="controls-row">
            <span id="pagingStatus" class="paging-status">
                Total: <b>@administrativeAreal2DReferences.Count</b> (<span id="shownVal">@Math.Min(administrativeAreal2DReferences.Count, initialLimit)</span>)
            </span>
            <div id="paginationButtons">
                <button type="button" class="btn-buildings btn-active btn-pager" onclick="revealNext(100)">+100</button>
                <button type="button" class="btn-buildings btn-pager btn-pager-all" onclick="revealAll()">All</button>
            </div>
        </div>
    }
    <table class="gis-table" id="adminArealTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Code</th>
                <th>Buildings</th>
                <th>Orto Datas Coverage</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < administrativeAreal2DReferences.Count; i++)
            {
                AdministrativeAreal2DReference administrativeAreal2DReference = administrativeAreal2DReferences[i];
                <tr class="@(i >= initialLimit ? "row-hidden" : "")">
                    <td class="index-column">@(i + 1)</td>
                    <td class="fw-medium">@administrativeAreal2DReference.Name</td>
                    <td>
                        <a href="~/administrativeareal2D/administrativeareal2Dreferencesbyid?id=@administrativeAreal2DReference.Id"
                               class="btn-buildings btn-active">
                            @administrativeAreal2DReference.Code
                        </a>
                    </td>
                    <td>
                        @if ((int)administrativeAreal2DReference.AdministrativeArealType >= (int)AdministrativeArealType.County)
                        {
                            <a href="~/building2D/building2Dreferencesbyadministrativeareal2Did?administrativeareal2Did=@administrativeAreal2DReference.Id"
                               class="btn-buildings btn-active">Buildings</a>
                        }
                        else
                        {
                            <button class="btn-buildings btn-disabled" disabled>Buildings</button>
                        }
                    </td>
                    <td>
                        <div class="coverage-wrapper">
                            <span id="text-coverage-@administrativeAreal2DReference.Id" class="coverage-text">
                                Loading...
                            </span>
                            <div class="coverage-container">
                                <div id="bar-coverage-@administrativeAreal2DReference.Id" class="coverage-bar"></div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
