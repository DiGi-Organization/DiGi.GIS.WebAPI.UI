@model DiGi.GIS.WebAPI.UI.ViewModels.GLTFSceneViewModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@using System.Globalization
@{
    ViewData["Title"] = Model.Title ?? "3D Viewer";
    ViewData["Description"] = "Interactive 3D glTF view with object selection, properties panel and dynamic lighting.";

    // "Solar radiation" panel (DiGi.GIS.WebAPI.UI#66): rendered only when the page knows its building by identifier.
    DiGi.GIS.WebAPI.UI.ViewModels.SolarSettingsViewModel? solarSettings = Model.SolarSettings;
    double solarScaleMax = DiGi.GIS.WebAPI.UI.Constants.Default.SolarIrradiationScaleMax;
    string? solarGradient = null;
    if (solarSettings is not null)
    {
        // The legend ramp is sampled from the same function that colours the surfaces.
        List<string> gradientStops = [];
        for (int i = 0; i <= 8; i++)
        {
            string? hex = DiGi.GIS.WebAPI.UI.Query.Hex(DiGi.GIS.WebAPI.UI.Query.SolarIrradiationColor(solarScaleMax * i / 8));
            gradientStops.Add($"{hex} {(i * 12.5).ToString(CultureInfo.InvariantCulture)}%");
        }
        solarGradient = $"linear-gradient(to right, {string.Join(", ", gradientStops)})";
    }
}

<div class="gis-panel gis-panel-full">
    <div class="gltf-layout gltf-left-panel-collapsed">
        @* Left side panel (hidden by default) *@
        <aside id="gltf-left-panel" class="gltf-left-panel">
            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Controls</h3>
                <div class="gltf-controls-list">
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Middle drag</span>
                        <span class="gltf-control-val">Pan</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Shift + Middle drag</span>
                        <span class="gltf-control-val">Orbit</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Scroll wheel</span>
                        <span class="gltf-control-val">Zoom</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Left drag (L → R)</span>
                        <span class="gltf-control-val">Window select</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Left drag (R → L)</span>
                        <span class="gltf-control-val">Crossing select</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Right click</span>
                        <span class="gltf-control-val">Context menu</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Drag box edge</span>
                        <span class="gltf-control-val">Move scope box</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Click box edge</span>
                        <span class="gltf-control-val">Resize/rotate handles</span>
                    </div>
                </div>
            </div>

            @* Environment settings card: the generic viewer engine mounts its controls (gizmo/ground/shade
               visibility, fog, view range) into the #gltf-settings element. *@
            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Settings</h3>
                <div id="gltf-settings"></div>
            </div>

            @* Solar radiation card (solar-tools.js): Calculate colours the receiving walls and roofs of the scene in
               place, Clear restores them. The neighbour radius is the Radius of the page, limited to the solar maximum. *@
            @if (solarSettings is not null)
            {
                <div class="gis-card gltf-card" id="solar-card">
                    <h3 class="gltf-card-title">Solar radiation</h3>
                    <button type="button" id="solar-calculate-button" class="gis-button" disabled title="Calculate the annual solar radiation on the external walls and roofs">Calculate</button>
                    <button type="button" id="solar-clear-button" class="gis-button" disabled title="Restore the original colours and remove the results">Clear</button>
                    <div id="solar-message" class="gltf-muted solar-message" style="display: none;"></div>
                </div>
            }
        </aside>

        @* Left resizer (hidden by default) *@
        <div id="gltf-left-resizer" class="gltf-resizer" role="separator" aria-label="Resize left panels"></div>

        @* Streamed delivery: the viewer fetches the binary glTF payload from data-glb-url; when the
           attribute is empty, the embedded base64 payload below is used instead.
           data-status-terminal: boolean flag of the task status terminal docked to the bottom edge
           of the 3D view — "false" removes the text area and its splitter entirely.
           data-scope-box-size: default scope box preset "halfX;halfY;zMin;zMax" or "halfX;halfY" (DiGi coordinates; the latter fits Z to the buildings' elevation);
           empty falls back to the engine's bounds-fit default.
           data-surroundings-glb-url: optional URL of the surrounding elements payload; when present the Settings card offers the
           "Show surrounding elements" checkbox and the Transparency slider, and the payload is fetched only on the first check.
           data-solar-*: the "Solar radiation" panel - the view and background job routes, their query (id, countyid and the
           clamped radius), the radius used and the one the page asked for, and the job poll interval. *@
        <div id="gltf-viewer-container"
             data-status-terminal="true"
             data-scope-box-size="@Model.ScopeBoxSize"
             data-glb-url="@(string.IsNullOrEmpty(Model.GLBUrl) ? string.Empty : Url.Content(Model.GLBUrl))"
             data-surroundings-glb-url="@(string.IsNullOrEmpty(Model.SurroundingsGLBUrl) ? null : Url.Content(Model.SurroundingsGLBUrl))"
             data-building-details-url="@Url.Content("~/building2D/detailsbyreference")"
             data-buildingmodel-details-url="@Url.Content("~/buildingmodel/itembyreference")"
             data-sun-direction-url="@Url.Content("~/solar/sundirection")"
             data-view-range-min="@Model.ViewRange?.Minimum.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-view-range-max="@Model.ViewRange?.Maximum.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-view-range-default="@Model.ViewRange?.Default.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-solar-view-url="@(solarSettings is null ? null : Url.Content("~/solar/viewbybuildingmodelid"))"
             data-solar-jobs-url="@(solarSettings is null ? null : Url.Content("~/solar/jobs"))"
             data-solar-query="@solarSettings?.Query"
             data-solar-radius="@solarSettings?.Radius.ToString(CultureInfo.InvariantCulture)"
             data-solar-radius-requested="@solarSettings?.RadiusRequested.ToString(CultureInfo.InvariantCulture)"
             data-solar-job-poll-seconds="@(solarSettings is null ? null : DiGi.GIS.WebAPI.UI.Constants.Default.SolarJobPollSeconds.ToString(CultureInfo.InvariantCulture))">
            <div id="gltf-loader" class="gltf-loader">
                <div class="gis-loader"></div>
                <p class="gis-loader-text">Loading 3D scene…</p>
            </div>
            @if (solarSettings is not null)
            {
                <div id="solar-calculation-loader" class="gltf-loader" style="display: none;">
                    <div class="gis-loader"></div>
                    <p class="gis-loader-text">Calculating solar radiation…</p>
                </div>
            }
            @* Small toggle in the top-left corner that folds/unfolds the left side panel. *@
            <button type="button" id="gltf-left-panel-toggle" class="gltf-left-panel-toggle" title="Show controls" aria-label="Show controls" aria-controls="gltf-left-panel" aria-expanded="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </button>
            @* Small toggle in the top-right corner that folds/unfolds the right side panel. *@
            <button type="button" id="gltf-panel-toggle" class="gltf-panel-toggle" title="Hide panel" aria-label="Hide panel" aria-controls="gltf-side-panel" aria-expanded="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </button>
            @* Hover label, selection marquee, navigation hint and right-click context menu (Fit view,
               Fit selection, Clear selection) overlays are created by the generic viewer engine. *@
        </div>

        <div id="gltf-resizer" class="gltf-resizer" role="separator" aria-label="Resize panels"></div>

        @* The cards are kept in alphabetical order by title (General, Lighting, Properties, Results, Scene, Selection) —
           hidden cards (Results, Selection) appear in place when a calculation or user interaction reveals them. *@
        <aside id="gltf-side-panel" class="gltf-side-panel">
            @if (Model.Title != null && Model.Title.StartsWith("BuildingModel "))
            {
                var buildingId = ViewData["Building2DReference"] as string ?? Model.Title.Substring("BuildingModel ".Length).Trim();
                <div class="gis-card gltf-card" id="building-general-card" data-building-id="@buildingId" style="display: none;">
                    <h3 class="gltf-card-title">General</h3>
                    <a id="building-general-details-link" class="gis-button" href="#" target="_blank" rel="noopener">Details</a>
                </div>
            }

            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Lighting</h3>
                @* Date + time drive the sun position: on change the scene's world location and the
                   selected moment go to the sun-direction endpoint (DiGi.Solar / DiGi.GIS server
                   side) and the returned azimuth/altitude animate the two sliders below. *@
                <label class="gltf-slider-label">Date
                    <input type="date" id="gltf-sun-date" class="gltf-date-input" />
                </label>
                <label class="gltf-slider-label">Time <span id="gltf-sun-hour-value"></span>
                    <input type="range" id="gltf-sun-hour" min="0" max="24" step="0.25" />
                </label>
                <label class="gltf-slider-label">Sun azimuth <span id="gltf-sun-azimuth-value"></span>
                    <input type="range" id="gltf-sun-azimuth" min="0" max="360" step="1" />
                </label>
                <label class="gltf-slider-label">Sun altitude <span id="gltf-sun-altitude-value"></span>
                    <input type="range" id="gltf-sun-altitude" min="2" max="90" step="1" />
                </label>
                <label class="gltf-slider-label">Sun intensity <span id="gltf-sun-intensity-value"></span>
                    <input type="range" id="gltf-sun-intensity" min="0" max="5" step="0.1" />
                </label>
                <label class="gltf-slider-label">Ambient intensity <span id="gltf-ambient-intensity-value"></span>
                    <input type="range" id="gltf-ambient-intensity" min="0" max="2" step="0.05" />
                </label>
            </div>

            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Properties</h3>
                <div id="gltf-properties" class="gltf-properties">
                    <span class="gltf-muted">Click an object or drag a selection rectangle in the 3D view. Properties are displayed when exactly one object is selected.</span>
                </div>
            </div>

            @* Results card: hidden until an analysis succeeds. Each analysis owns one .gltf-results-section, separated
               from the next by a divider, so further analyses can add theirs to the same card. *@
            @if (solarSettings is not null)
            {
                <div class="gis-card gltf-card" id="gltf-results-card" data-expanded="true" style="display: none;">
                    <h3 class="gltf-card-title">Results</h3>
                    <section class="gltf-results-section" id="solar-results-section" style="display: none;">
                        <h4 class="gltf-results-section-title">Solar radiation</h4>
                        <div class="gltf-muted">Annual irradiation [kWh/m²]</div>
                        <div class="solar-ramp" style="background: @solarGradient;" role="img" aria-label="Colour ramp from 0 to @solarScaleMax.ToString(CultureInfo.InvariantCulture) kWh/m² per year"></div>
                        <div class="solar-ramp-scale">
                            <span>0</span>
                            <span>@((solarScaleMax / 2).ToString(CultureInfo.InvariantCulture))</span>
                            <span>@solarScaleMax.ToString(CultureInfo.InvariantCulture)+</span>
                        </div>
                        <div class="gltf-controls-list">
                            <div class="gltf-control-row">
                                <span class="gltf-control-key">Neighbours</span>
                                <span class="gltf-control-val" id="solar-results-radius"></span>
                            </div>
                            <div class="gltf-control-row">
                                <span class="gltf-control-key">Weather</span>
                                <span class="gltf-control-val" id="solar-results-station"></span>
                            </div>
                            <div class="gltf-control-row">
                                <span class="gltf-control-key">Result</span>
                                <span class="gltf-control-val" id="solar-results-origin"></span>
                            </div>
                        </div>
                        <label class="solar-flat-label">
                            <input type="checkbox" id="solar-flat-checkbox" checked />
                            Flat result colours
                        </label>
                        <div class="gltf-muted">Walls and roofs only; other components keep their colour. Isotropic sky: neighbours shade the direct beam, not the diffuse light.</div>
                    </section>
                </div>
            }

            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Scene</h3>
                <div id="gltf-scene-info" class="gltf-properties"></div>
            </div>

            @* Selection card: shown by building-details-panel.js when exactly one building is selected;
               "Details" opens the standalone building details page, "Export" shows the selected
               object's data as formatted JSON in a modal. *@
            <div class="gis-card gltf-card" id="building-details-card" style="display: none;">
                <h3 class="gltf-card-title">Selection</h3>
                <a id="building-details-show-link" class="gis-button" href="#" target="_blank" rel="noopener">Details</a>
                <button type="button" id="building-export-button" class="gis-button">Export</button>
            </div>
        </aside>
    </div>
</div>

<script type="application/json" id="gltf-scene-data">@Html.Raw(Model.GLTFSceneJson ?? "null")</script>
@* Html.Raw is required: Razor would HTML-encode '+' characters of the base64 payload, and entities are not decoded inside script elements. *@
<script type="text/plain" id="gltf-glb-base64">@Html.Raw(Model.GLBBase64)</script>

@section Scripts {
    @* The '!' prefix opts this element out of tag helper processing: the script tag helper
       would otherwise strip the type="importmap" attribute and break module resolution. *@
    <!script type="importmap">
        {
            "imports": {
                "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
                "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/",
                "three-mesh-bvh": "https://cdn.jsdelivr.net/npm/three-mesh-bvh@0.8/build/index.module.js",
                "gltf-viewer-core": "@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/js/gltf-viewer-core.js")",
                "http-refusal": "@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/js/http-refusal.js")",
                "solar-job": "@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/js/solar-job.js")"
            }
        }
    </!script>
    <script type="module" src="~/js/gltf-viewer.js" asp-append-version="true"></script>
    <script type="module" src="~/js/building-details-panel.js" asp-append-version="true"></script>
    @if (solarSettings is not null)
    {
        <script type="module" src="~/js/solar-tools.js" asp-append-version="true"></script>
    }
}
