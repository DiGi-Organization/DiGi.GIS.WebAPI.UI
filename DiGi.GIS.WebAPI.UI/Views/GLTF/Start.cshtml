@{
    ViewData["Title"] = "3D Viewer";
    ViewData["Description"] = "Render buildings and spatial objects in 3D using the glTF standard.";
}

<div class="gis-panel">
    <div class="gis-card gis-hero-card">
        @* Single-building line icon (consistent line-icon set shared with the communication start page). *@
        <div class="gis-hero-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true">
                <rect width="16" height="20" x="4" y="2" rx="2" ry="2" />
                <path d="M9 22v-4h6v4" />
                <path d="M8 6h.01" />
                <path d="M16 6h.01" />
                <path d="M12 6h.01" />
                <path d="M12 10h.01" />
                <path d="M12 14h.01" />
                <path d="M16 10h.01" />
                <path d="M16 14h.01" />
                <path d="M8 10h.01" />
                <path d="M8 14h.01" />
            </svg>
        </div>
        <h2 class="gis-title gis-title-hero">Building Viewer</h2>
        <p class="gis-hero-text">
            Load a single building by its identifier and explore it in 3D. The footprint is extruded to the building height from its number of storeys, so you can inspect its shape, size and surroundings from any angle.
        </p>
        <form id="buildingmodel-id-form" method="get" action="~/buildingmodel/buildingmodelbyid" class="gis-inline-form">
            <label>Building Id
                <input type="number" name="id" value="5072294" required class="gis-input-lg" />
            </label>
            <label>County Id
                <input type="number" name="countyid" value="12668" class="gis-input-sm" />
            </label>
            <label>Radius [m]
                <input type="number" name="radius" step="any" min="1" max="666" placeholder="default" class="gis-input-lg" />
            </label>
            <button type="submit" class="gis-button">Open</button>
        </form>
    </div>

    <div class="gis-card gis-hero-card">
        @* Multiple-buildings line icon (consistent line-icon set shared with the communication start page). *@
        <div class="gis-hero-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true">
                <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
                <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
                <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
                <path d="M10 6h4" />
                <path d="M10 10h4" />
                <path d="M10 14h4" />
                <path d="M10 18h4" />
            </svg>
        </div>
        <h2 class="gis-title gis-title-hero">Multiple Buildings Viewer</h2>
        <p class="gis-hero-text">
            Enter a central point and a radius to load all buildings within that circular area and explore the whole district in 3D.
        </p>
        <form id="buildingmodel-radius-form" method="get" action="~/buildingmodel/itemsbyradius" class="gis-inline-form">
            <label>Point X
                <input type="number" name="centerX" value="629671.3" step="any" required />
            </label>
            <label>Point Y
                <input type="number" name="centerY" value="489136.8" step="any" required />
            </label>
            <label>Radius [m]
                <input type="number" name="radius" value="500" step="any" min="1" required class="gis-input-sm" />
            </label>
            <button type="submit" class="gis-button">Open</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/gis-common.js" asp-append-version="true"></script>
    <script>
        setupDisplayAreaRadiusValidation('#buildingmodel-radius-form');
        // The Building Viewer radius is the minimum view range; the ground is loaded out to 3 times it, and at most 2000 m.
        setupDisplayAreaRadiusValidation('#buildingmodel-id-form', 'radius', 666, 666);
    </script>
}
