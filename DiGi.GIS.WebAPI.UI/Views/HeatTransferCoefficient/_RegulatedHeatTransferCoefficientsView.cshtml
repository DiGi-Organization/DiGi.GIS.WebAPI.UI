@using DiGi.Analytical.Building.HVAC.Classes
@using DiGi.Analytical.Building.HVAC.Interfaces
@using DiGi.GIS.Classes
@using System.Linq
@using System.Collections.Generic
@using DiGi.GIS.WebAPI.UI.Enums
@using DiGi.GIS.WebAPI.UI.ViewModels
@using DiGi.GIS.PostgreSQL.Classes
@using DiGi.GIS.PostgreSQL.Enums
@using DiGi.GIS.Interfaces

@model RegulatedHeatTransferCoefficientsViewModel

@{
    // Ensure we have a valid model instance using explicit typing
    RegulatedHeatTransferCoefficientsViewModel viewData = Model ?? new RegulatedHeatTransferCoefficientsViewModel();
}

@if (viewData.RegulatedHeatTransferCoefficients is IRegulatedHeatTransferCoefficients regulatedHeatTransferCoefficients)
{
    <div class="property-group">
        <table class="gis-property-table">
            @if (regulatedHeatTransferCoefficients.RegulationAct is RegulationAct regulationAct)
            {
                <tr>
                    <td class="property-label">Reference</td>
                    <td>@regulationAct.Reference</td>
                </tr>
                <tr>
                    <td class="property-label">Publication Date</td>
                    <td>@regulationAct.PublicationDate.ToShortDateString()</td>
                </tr>
                <tr>
                    <td class="property-label">Effective Date</td>
                    <td>@regulationAct.EffectiveDate.ToShortDateString()</td>
                </tr>
                <tr>
                    <td class="property-label">Name</td>
                    <td>@regulationAct.Name</td>
                </tr>
            }

            @if (viewData.RegulatedBuildingCategory != RegulatedBuildingCategory.Undefined)
            {
                <tr>
                    <td class="property-label">Building Category</td>
                    <td>@(DiGi.Core.Query.Description(viewData.RegulatedBuildingCategory) ?? viewData.RegulatedBuildingCategory.ToString())</td>
                </tr>
            }

            @* The controller selects the limits that apply to the building's category (DiGi.GIS.WebAPI.UI#82). *@
            @foreach (string name in viewData.Names)
            {
                regulatedHeatTransferCoefficients.TryGetValue(name, out double coefficientValue);

                <tr>
                    <td class="property-label">@name:</td>
                    <td>@coefficientValue [W/(m²·K)]</td>
                </tr>
            }

            @* A minimum thermal resistance is a resistance, never a heat transfer coefficient. *@
            @foreach (string name in viewData.MinimumThermalResistanceNames)
            {
                regulatedHeatTransferCoefficients.TryGetMinimumThermalResistance(name, out double minimumThermalResistance);

                <tr>
                    <td class="property-label">@name (minimum thermal resistance):</td>
                    <td>@minimumThermalResistance [(m²·K)/W]</td>
                </tr>
            }

            @if (viewData.EnergyIndicatorRequirement)
            {
                <tr>
                    <td class="property-label">Multi-family building:</td>
                    <td>The single-family limits do not apply; the regulation limits the building by its seasonal heat demand indicator E ≤ E0.</td>
                </tr>
            }
        </table>
    </div>
}
