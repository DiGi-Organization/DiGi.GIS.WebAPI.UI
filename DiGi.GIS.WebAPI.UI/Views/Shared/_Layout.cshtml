<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GIS System</title>
    <meta name="description" content="@(ViewData["Description"] ?? "High-performance GIS data exchange platform by DigiProject.")" />
    <meta name="robots" content="@(ViewData["Robots"] ?? "index, follow")" />
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"] - GIS System" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "High-performance GIS data exchange platform by DigiProject.")" />
    <meta property="og:url" content="@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" />
    <meta property="og:image" content="https://digiproject.uk/images/og-share-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content="@ViewData["Title"] - GIS System" />
    <meta property="twitter:description" content="@(ViewData["Description"] ?? "High-performance GIS data exchange platform by DigiProject.")" />
    <meta property="twitter:image" content="https://digiproject.uk/images/og-share-image.png" />

    <link rel="stylesheet" href="~/css/gis-theme.css" asp-append-version="true" />
    <script>
        window.AppBaseUrl = '@Url.Content("~/")';
    </script>
</head>
<body class="gis-app-body">
    @* Remember the header/footer collapse across pages, tabs and windows. localStorage is per origin,
       so it survives new tabs and windows on the same domain. Applied as early as possible - before the
       <header> is parsed - so a returning visitor sees the collapsed layout on the first frame: no
       transition, no flash. This only reads; the toggle at the bottom of the body is the only writer. *@
    <script>
        (function () {
            'use strict';
            try {
                if (window.localStorage.getItem('gis-layout-collapsed') === 'true') {
                    document.body.classList.add('gis-layout-collapsed');
                }
            } catch (error) {
                // Blocked or private storage: keep the default (visible) layout.
            }
        })();
    </script>
    @{
        string currentPath = Context.Request.Path.Value ?? "";

        // Whether a session is being shown, not what it is: the token sits in an HttpOnly cookie, so only its
        // presence is knowable here. Should the token in it turn out to be spent, the first authenticated call
        // says so and the page swaps the control back to signed out (wwwroot/js/user.js).
        bool signedIn = Context.Request.Cookies.ContainsKey(DiGi.GIS.WebAPI.UI.Constants.Default.UserTokenCookieName);

        // Returning to the sign-in page after signing in would leave the visitor staring at the form they just
        // used, so that one address returns home instead.
        string returnUrl = currentPath.StartsWith("/login", StringComparison.OrdinalIgnoreCase) ? Url.Content("~/") : Context.Request.Path + Context.Request.QueryString;
        string loginUrl = Url.Content("~/login") + "?returnUrl=" + Uri.EscapeDataString(returnUrl);
    }
    <header class="gis-header">
        <div class="gis-header-container">
            <a href="~/" class="gis-logo-link">
                <img src="~/images/logo.png" alt="GIS Logo" class="gis-header-logo" />
            </a>
            @* The navigation links are collapsed into a hamburger button and dropdown menu. The menu
               items mirror the main menu (Views/Home/Start.cshtml), including Communication, the
               3D Viewer and the Typology entries. *@
            <nav class="gis-nav">
                @* Session control. Both forms are rendered and one of them hidden, so signing out swaps which
                   is visible rather than building markup in script. It wears the hamburger's own classes - only
                   the width differs - so the two controls cannot drift apart. *@
                <a id="gis-user-login" class="gis-nav-toggle gis-nav-toggle-wide" href="@loginUrl" hidden="@(signedIn ? "hidden" : null)">Log in</a>
                @* A disclosure rather than a menu, unlike the navigation dropdown beside it: most of what it
                   holds is the visitor's name and e-mail, which are content and not menu items, and role="menu"
                   admits only menuitem, separator and group as children. aria-expanded plus aria-controls is the
                   pattern for revealing a panel; the shared classes keep it looking identical either way. *@
                <button type="button" id="gis-user-toggle" class="gis-nav-toggle gis-nav-toggle-wide" aria-expanded="false" aria-controls="gis-user-menu" hidden="@(signedIn ? null : "hidden")">
                    Profile
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </button>
                <div id="gis-user-menu" class="gis-nav-menu" hidden>
                    @* Filled on first open from /user/me - see wwwroot/js/user.js. *@
                    <div class="gis-nav-menu-identity">
                        <span id="gis-user-name" class="fw-bold"></span>
                        <span id="gis-user-email" class="text-muted"></span>
                    </div>
                    <div class="gis-nav-menu-separator"></div>
                    <a id="gis-user-logout" href="#" class="gis-nav-link">Log out</a>
                </div>
                <button type="button" id="gis-nav-toggle" class="gis-nav-toggle" aria-label="Open navigation menu" aria-haspopup="true" aria-expanded="false" aria-controls="gis-nav-menu">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true">
                        <line x1="4" x2="20" y1="6" y2="6" />
                        <line x1="4" x2="20" y1="12" y2="12" />
                        <line x1="4" x2="20" y1="18" y2="18" />
                    </svg>
                </button>
                <div id="gis-nav-menu" class="gis-nav-menu" role="menu" hidden>
                    <a href="~/administrativeareal2D" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/administrativeareal2D", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Administrative Areas</a>
                    <a href="~/building2D" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/building2D", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Buildings</a>
                    @* Mirrors the Orto Data button of the main menu, behind the same session check - the
                       page requires a signed-in visitor. The active test must not use a bare StartsWith
                       on "/ortodata": it would also light up for /ortodatas, the building details panel. *@
                    @if (signedIn)
                    {
                        <a href="~/ortodata" role="menuitem" class="gis-nav-link @(currentPath == "/ortodata" || currentPath.StartsWith("/ortodata/", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Orto Data</a>
                    }
                    <a href="~/communication" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/communication", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Communication</a>
                    <a href="~/buildingmodel" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/buildingmodel", StringComparison.OrdinalIgnoreCase) ? "active" : "")">3D Viewer</a>
                    <a href="~/terrain" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/terrain", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Terrain</a>
                    <a href="~/typology" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/typology", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Typology</a>
                    <a href="~/about" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/about", StringComparison.OrdinalIgnoreCase) ? "active" : "")">About</a>
                </div>
            </nav>
        </div>
    </header>
    <button type="button" id="gis-layout-toggle" class="gis-layout-toggle" aria-label="Toggle header and footer" title="Toggle header and footer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="gis-layout-toggle-icon">
            <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
    </button>
    <main class="gis-content-wrapper">
        @RenderBody()
    </main>
    <footer class="gis-footer">
        <div class="gis-footer-container">
            <div class="gis-footer-left">
                <a href="https://digiproject.uk" class="gis-footer-logo-link">
                    <img src="~/images/digiproject-logo.png" alt="DigiProject Logo" class="gis-footer-logo" />
                </a>
            </div>
            <div class="gis-footer-center">
                <span class="gis-footer-copyright">
                    Copyright @@ 2026 - DigiProject. Designed by <a href="mailto:digiproject@digiproject.uk" class="gis-footer-link">DigiProject team</a>
                </span>
            </div>
            <div class="gis-footer-right">
                <!-- Spacer for perfect centering -->
            </div>
        </div>
    </footer>
    @* Header dropdowns: toggles a menu, closing on outside click or Escape. The navigation menu and the
       profile menu behave identically and are anchored to the same corner, so one function drives both and
       opening either closes the other. *@
    <script>
        (function () {
            var menus = [];

            function closeAll() {
                menus.forEach(function (entry) {
                    entry.setOpen(false);
                });
            }

            function setupMenu(toggleId, menuId) {
                var toggle = document.getElementById(toggleId);
                var menu = document.getElementById(menuId);
                if (!toggle || !menu) {
                    return;
                }

                function setOpen(open) {
                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                    menu.hidden = !open;
                }

                menus.push({ setOpen: setOpen });

                toggle.addEventListener('click', function (event) {
                    event.stopPropagation();
                    var open = menu.hidden;
                    closeAll();
                    setOpen(open);
                });

                document.addEventListener('click', function (event) {
                    if (!menu.hidden && !menu.contains(event.target) && !toggle.contains(event.target)) {
                        setOpen(false);
                    }
                });

                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape' && !menu.hidden) {
                        setOpen(false);
                        toggle.focus();
                    }
                });
            }

            setupMenu('gis-nav-toggle', 'gis-nav-menu');
            setupMenu('gis-user-toggle', 'gis-user-menu');
        })();

        (function () {
            var layoutToggle = document.getElementById('gis-layout-toggle');
            if (!layoutToggle) {
                return;
            }
            layoutToggle.addEventListener('click', function () {
                // classList.toggle returns the new state - persist it in the same step.
                var collapsed = document.body.classList.toggle('gis-layout-collapsed');
                try {
                    window.localStorage.setItem('gis-layout-collapsed', collapsed ? 'true' : 'false');
                } catch (error) {
                    // A blocked store only loses the preference; the UI still toggles.
                }
                
                // Trigger window resize event to adjust 3D viewports dynamically
                window.dispatchEvent(new Event('resize'));
                // Also trigger after the 300ms CSS transition completes to make sure the final bounds are correct
                setTimeout(function () {
                    window.dispatchEvent(new Event('resize'));
                }, 300);
            });
        })();
    </script>
    <script src="~/js/user.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
