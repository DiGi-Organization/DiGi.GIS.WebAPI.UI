@{
    ViewData["Title"] = "Typology";
    ViewData["Description"] = "Define a building typology: chain building-data columns into classification rules with ranges and colors, and load it for an administrative area.";
}

<div class="gis-panel">
    <div class="gis-card gis-hero-card">
        @* Stacked-strata line icon, from the same line-icon set as the Terrain, 3D viewer, Communication and Login start pages. *@
        <div class="gis-hero-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true">
                <path d="m12 3 8.5 4.25L12 11.5 3.5 7.25 12 3Z" />
                <path d="m3.5 12.25 8.5 4.25 8.5-4.25" />
                <path d="m3.5 16.75 8.5 4.25 8.5-4.25" />
            </svg>
        </div>
        <h2 class="gis-title gis-title-hero">Typology</h2>
        <p class="gis-hero-text">
            Chain columns of the building data into classification rules - rule type, ranges and the colors they map to - to define a building typology, then load it for an administrative area.
        </p>
    </div>

    <div class="gis-typology-layout">
        <div class="gis-card" id="typology-available-columns">
            <h3 class="gis-title">Available Columns</h3>
            <input type="text" id="typology-column-filter" class="gis-column-filter" placeholder="Filter columns…" autocomplete="off" />
            <div class="gis-column-list"></div>
        </div>
        @* The middle grid cell holds two cards (#41): the column chain, and beneath it the area both
           Load actions share. The wrapper is a flex column of the same fixed height as the outer cards,
           so the outer three-column grid stays as it is. *@
        <div class="gis-typology-column">
            <div class="gis-card" id="typology-selected-columns">
                <h3 class="gis-title">Selected Columns</h3>
                @* Import and Export (#17) sit under the heading of the chain they act on; Clear, pushed to
                   the right, empties the chain after a confirmation. The file input is the picker Import
                   opens and is never shown on its own. *@
                <div class="gis-form-row gis-typology-panel-actions">
                    <button type="button" id="typology-import-button" class="gis-button gis-button-secondary">Import</button>
                    <button type="button" id="typology-export-button" class="gis-button gis-button-secondary">Export</button>
                    <button type="button" id="typology-clear-columns-button" class="gis-button gis-button-secondary gis-typology-action-right" disabled>Clear</button>
                    <input type="file" id="typology-import-file" accept=".json,application/json" hidden />
                </div>
                <div class="gis-column-list"></div>
            </div>
            @* The Selected Area card (#41): the one administrative area that scopes both the values Load
               in Column Properties and the Load into the area view. typology.js renders the area (or the
               empty state) into the surface; Select opens the area modal without loading anything, Clear
               (pushed to the right) drops the area after a confirmation, and Load (#18, relocated here)
               stretches across the card's bottom and opens the area view in a new tab beside this page -
               prompting for an area only when none is set. *@
            <div class="gis-card" id="typology-selected-area">
                <h3 class="gis-title">Selected Area</h3>
                <div class="gis-typology-selected-area"></div>
                <div class="gis-form-row gis-typology-area-actions">
                    <button type="button" id="typology-select-area-button" class="gis-button gis-button-secondary">Select</button>
                    <button type="button" id="typology-clear-area-button" class="gis-button gis-button-secondary gis-typology-action-right" disabled>Clear</button>
                </div>
                <div class="gis-form-row">
                    <button type="button" id="typology-load-button" class="gis-button gis-button-stretch">Load</button>
                </div>
            </div>
        </div>
        <div class="gis-card" id="typology-column-properties">
            <h3 class="gis-title">Column Properties</h3>
            @* A form surface, not a list: typology.js renders the selected level's editor here (#16). *@
            <div class="gis-typology-properties"></div>
        </div>
    </div>
</div>

@* The Load modal (#18): static markup, shown and driven by typology.js with the same overlay and dialog
   classes as the export and error dialogs. The results box is a listbox whose rows are options - click
   or keyboard selects one, and OK stays disabled until then. *@
<div id="typology-load-modal" class="gis-modal-overlay" style="display: none;">
    <div class="gis-card gis-modal gis-modal-load" role="dialog" aria-modal="true" aria-labelledby="typology-load-title">
        <h3 class="gis-title" id="typology-load-title">Load Area</h3>
        <label class="gis-field-label" for="typology-load-input">Search an administrative area (Voivodeship, County, Municipality or Subdivision)
            <input type="text" id="typology-load-input" class="gis-column-filter" placeholder="Type a name&#8230;" autocomplete="off" spellcheck="false" />
        </label>
        <div id="typology-load-results" class="gis-scroll-box gis-typology-load-results" role="listbox" aria-label="Matching administrative areas"></div>
        <div class="gis-modal-buttons">
            <button type="button" id="typology-load-cancel-button" class="gis-button gis-button-secondary">Cancel</button>
            <button type="button" id="typology-load-ok-button" class="gis-button" disabled>OK</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/typology.js" asp-append-version="true"></script>
}
