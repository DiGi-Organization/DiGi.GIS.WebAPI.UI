@model DiGi.GIS.WebAPI.UI.ViewModels.TypologyViewViewModel
@{
    ViewData["Title"] = "Typology View";
    ViewData["Description"] = "Colour-coded building typology for a selected administrative area.";
    @* Keep noindex, follow: the colouring depends on a definition carried in localStorage, so the
       page is not a stable, indexable document. *@
    ViewData["Robots"] = "noindex, follow";
}

@* The 3-column shell (issue #23): left panel open, right panel closed, a flexing centre viewport holding
   the SVG map. The left panel opens with the Administrative Area card (the area context and the way back
   to the definition page), then the solved typology tree over a pie of the current selection (issue #24);
   the centre (issue #25) draws the outline and the buildings as dots coloured by their typology; the
   right panel is a later sub-issue of #21. The layout is definition-agnostic, so a visit with no carried
   definition still shows the area context. The data-area-* attributes carry the solve request's area to
   the script; the type travels as the integer the wire binds, never a name. *@
<div class="gis-panel gis-panel-full">
    <div class="typology-shell" data-area-id="@Model.Id" data-area-code="@Model.Code" data-area-type="@((int)Model.AdministrativeArealType)">
        @* Inverted default vs the 3D viewer: the right panel is CLOSED (typology-panel-collapsed on the
           row) and the left panel is OPEN (no typology-left-panel-collapsed). *@
        <div class="typology-layout typology-panel-collapsed">
            @* Left side panel (open by default): the area card, then the typology tree over the
               distribution pie (issue #24), with the solve's loader and the empty-state lines (issue #27).
               Tree and pie are filled by wwwroot/js/typology-panel.js once the solve answers; until then
               the loader or the status line reads. *@
            <aside id="typology-left-panel" class="typology-left-panel">
                @* Area card: the context the page was opened with. Always rendered; the name is blank when
                   the lookup answered nothing. *@
                <div class="gis-card gltf-card typology-area-card">
                    <h3 class="typology-card-title"><span>Administrative Area</span></h3>
                    <dl class="typology-area-list">
                        <div class="typology-area-item"><dt class="typology-area-label">Name</dt><dd class="typology-area-value">@Model.Name</dd></div>
                        <div class="typology-area-item"><dt class="typology-area-label">Type</dt><dd class="typology-area-value">@Model.AdministrativeArealTypeName</dd></div>
                        <div class="typology-area-item"><dt class="typology-area-label">Code</dt><dd class="typology-area-value">@Model.Code</dd></div>
                        <div class="typology-area-item"><dt class="typology-area-label">Id</dt><dd class="typology-area-value">@Model.Id</dd></div>
                    </dl>
                    <a href="~/typology" class="gis-button typology-area-back">Back to the definition page</a>
                </div>
                <div class="gis-card gltf-card typology-tree-card">
                    <h3 class="typology-card-title">
                        <span>Typology</span>
                        <button type="button" id="typology-tree-clear" class="gis-button gis-button-icon gis-button-secondary" title="Clear selection" aria-label="Clear selection" disabled>&times;</button>
                    </h3>
                    <p id="typology-tree-status" class="typology-muted">Solving the typology for the area&hellip;</p>
                    @* The solve's loader (issue #27): shown while the POST is in flight, hidden on settle;
                       never at the same time as the status line or the tree. *@
                    <div id="typology-tree-loader" class="typology-tree-loader" hidden>
                        <div class="gis-loader"></div>
                        <p class="gis-loader-text">Solving the typology for the area&hellip;</p>
                    </div>
                    <div id="typology-tree" class="typology-tree" role="tree" aria-label="Typology tree" hidden></div>
                    @* The drill-down (issue #53, B2): the child areas of an area above the solve ceiling,
                       offered in the left card instead of the 413 modal for a voivodeship or the country. *@
                    <div id="typology-child-areas" class="typology-child-areas" hidden>
                        <p class="typology-muted" id="typology-child-areas-text"></p>
                        <ul class="typology-child-area-list" id="typology-child-area-list"></ul>
                    </div>
                </div>
                <div class="gis-card gltf-card typology-pie-card">
                    <h3 class="typology-card-title" id="typology-pie-title"><span>Distribution</span><span id="typology-pie-focus" class="typology-muted"></span></h3>
                    <div id="typology-pie" class="typology-pie" aria-labelledby="typology-pie-title"></div>
                    <p id="typology-pie-empty" class="typology-muted" hidden></p>
                    <ul id="typology-pie-legend" class="typology-pie-legend"></ul>
                </div>
            </aside>

            @* Left resizer *@
            <div id="typology-left-resizer" class="typology-resizer" role="separator" aria-orientation="vertical" aria-label="Resize left panel"></div>

            @* Centre viewport: the SVG mount point. The two panel toggles dock in its corners, exactly
               like the 3D viewer container. *@
            <div id="typology-viewport" class="typology-viewport">
                @* The 2D map (issue #25): a viewBox the browser scales with the viewport, so every panel drag or
                   toggle refits it with no script; the wheel zooms it about the pointer, a drag pans it and a
                   double click fits the outline again (typology-map.js). Three layers in paint order - the area
                   outline, the building dots grouped per typology path, the selected-building marker - all
                   filled by wwwroot/js/typology-map.js. The status line beneath is the placeholder until the
                   outline draws, then only an empty or unavailable message. *@
                <svg id="typology-map" class="typology-map" viewBox="0 0 500 500" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Buildings of the area coloured by typology">
                    <g id="typology-map-outline"></g>
                    <g id="typology-map-points"></g>
                    <g id="typology-map-marker"></g>
                </svg>
                <div id="typology-map-label" class="typology-map-label" hidden></div>
                <div id="typology-viewport-empty" class="typology-viewport-empty">
                    <p class="typology-muted">Buildings will be drawn here in the colours of the defined typology.</p>
                </div>

                @* Left toggle: open by default. *@
                <button type="button" id="typology-left-panel-toggle" class="typology-panel-toggle typology-left-panel-toggle" title="Hide panel" aria-label="Hide panel" aria-controls="typology-left-panel" aria-expanded="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m9 18 6-6-6-6" />
                    </svg>
                </button>

                @* Right toggle: closed by default. *@
                <button type="button" id="typology-panel-toggle" class="typology-panel-toggle typology-right-panel-toggle" title="Show panel" aria-label="Show panel" aria-controls="typology-side-panel" aria-expanded="false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m9 18 6-6-6-6" />
                    </svg>
                </button>
            </div>

            @* Right resizer *@
            <div id="typology-resizer" class="typology-resizer" role="separator" aria-orientation="vertical" aria-label="Resize right panel"></div>

            @* Right side panel (closed by default; issue #26). Four cards filled by wwwroot/js/typology-inspector.js:
               the selected typology node's properties, its representative building, the windowed grid of its
               buildings, and the info of the building picked from the grid or the map. The inspector opens the panel on the first tree selection
               and closes it when the selection clears. *@
            <aside id="typology-side-panel" class="typology-side-panel">
                <div class="gis-card gltf-card typology-inspector-card">
                    <h3 class="typology-card-title"><span>Typology</span></h3>
                    <p id="typology-inspector-empty" class="typology-muted">Select a typology in the tree to inspect it.</p>
                    <div id="typology-inspector" class="typology-inspector" hidden>
                        <div class="typology-inspector-head">
                            <span id="typology-inspector-swatch" class="typology-tree-swatch" aria-hidden="true"></span>
                            <span id="typology-inspector-name" class="typology-inspector-name"></span>
                        </div>
                        <nav id="typology-inspector-breadcrumb" class="typology-inspector-breadcrumb" aria-label="Typology path"></nav>
                        <dl class="typology-area-list">
                            <div class="typology-area-item"><dt class="typology-area-label typology-info-label">Buildings</dt><dd id="typology-inspector-count" class="typology-area-value"></dd></div>
                            <div class="typology-area-item"><dt class="typology-area-label typology-info-label">Share</dt><dd id="typology-inspector-share" class="typology-area-value"></dd></div>
                        </dl>
                        <p id="typology-inspector-description" class="typology-muted typology-inspector-description" hidden></p>
                    </div>
                </div>

                @* Representative: on demand, the real building most typical of the selected typology over the
                   definition's parameters (POST /typology/representative), its values beside the typology's
                   typical ones, and the synthetic archetype derived from it. Filled by typology-inspector.js;
                   cleared on every selection change. *@
                <div class="gis-card gltf-card typology-representative-card">
                    <h3 class="typology-card-title"><span>Representative</span></h3>
                    <p id="typology-representative-empty" class="typology-muted">Select a typology in the tree to find its representative building.</p>
                    <button type="button" id="typology-representative-find" class="gis-button typology-representative-find" hidden>Find representative</button>
                    <div id="typology-representative-loader" class="typology-tree-loader" hidden>
                        <div class="gis-loader"></div>
                        <p class="gis-loader-text" id="typology-representative-loader-text"></p>
                    </div>
                    <p id="typology-representative-status" class="typology-muted" hidden></p>
                    <div id="typology-representative" class="typology-building" hidden>
                        <dl class="typology-area-list">
                            <div class="typology-area-item"><dt class="typology-area-label typology-info-label">Reference</dt><dd class="typology-area-value typology-mono"><button type="button" id="typology-representative-reference" class="typology-representative-reference" title="Select the building in the list and on the map"></button></dd></div>
                            <div class="typology-area-item"><dt class="typology-area-label typology-info-label">Mean distance</dt><dd id="typology-representative-mean" class="typology-area-value" title="Mean distance to the typology's other buildings, in interquartile ranges per parameter"></dd></div>
                            <div class="typology-area-item"><dt class="typology-area-label typology-info-label">90th percentile</dt><dd id="typology-representative-p90" class="typology-area-value" title="90th percentile of the distances to the typology's other buildings, in interquartile ranges per parameter"></dd></div>
                            @* One row per definition level: the representative's value, then the typology's median
                               (numeric) or most common value (categorical) in brackets. *@
                            <div id="typology-representative-parameters"></div>
                            <div class="typology-area-item"><dt class="typology-area-label typology-info-label">Archetype</dt><dd id="typology-representative-archetype-size" class="typology-area-value" title="Median floor area and storeys of the typology: the synthetic archetype's size"></dd></div>
                        </dl>
                        <p id="typology-representative-note" class="typology-muted" hidden></p>
                        <div class="typology-building-links">
                            <a id="typology-representative-model" class="gis-button" target="_blank" rel="noopener" hidden>3D Viewer</a>
                            <a id="typology-representative-archetype" class="gis-button" target="_blank" rel="noopener" hidden>Synthetic archetype</a>
                        </div>
                    </div>
                </div>

                @* Building grid: a text filter over the reference and a windowed list - only the visible slice of
                   rows is in the DOM, the spacer keeps the scroll height of the whole list. *@
                <div class="gis-card gltf-card typology-grid-card">
                    <h3 class="typology-card-title"><span>Buildings</span><span id="typology-grid-count" class="typology-muted"></span></h3>
                    <input type="search" id="typology-grid-filter" class="gis-column-filter typology-grid-filter" placeholder="Filter by reference" aria-label="Filter buildings by reference" autocomplete="off" disabled />
                    <p id="typology-grid-empty" class="typology-muted">No typology selected.</p>
                    <div id="typology-grid" class="typology-grid" role="listbox" aria-label="Buildings of the selected typology" tabindex="0" hidden>
                        <div id="typology-grid-spacer" class="typology-grid-spacer">
                            <div id="typology-grid-slice" class="typology-grid-slice"></div>
                        </div>
                    </div>
                </div>

                @* Building info: the DTO entry plus the centroid, and links to the existing 2D details page and
                   the 3D viewer. No per-building request is made. *@
                <div class="gis-card gltf-card typology-building-card">
                    <h3 class="typology-card-title"><span>Building</span></h3>
                    <p id="typology-building-empty" class="typology-muted">Select a building in the list or on the map.</p>
                    <div id="typology-building" class="typology-building" hidden>
                        <dl class="typology-area-list">
                            <div class="typology-area-item"><dt class="typology-area-label typology-info-label">Reference</dt><dd id="typology-building-reference" class="typology-area-value typology-mono"></dd></div>
                            <div class="typology-area-item"><dt class="typology-area-label typology-info-label">Id</dt><dd id="typology-building-id" class="typology-area-value"></dd></div>
                            <div class="typology-area-item"><dt class="typology-area-label typology-info-label">County id</dt><dd id="typology-building-county" class="typology-area-value"></dd></div>
                            <div class="typology-area-item"><dt class="typology-area-label typology-info-label">X</dt><dd id="typology-building-x" class="typology-area-value"></dd></div>
                            <div class="typology-area-item"><dt class="typology-area-label typology-info-label">Y</dt><dd id="typology-building-y" class="typology-area-value"></dd></div>
                            @* One row per typology level of the building's path (the level's column name as the
                               label, the corresponding node name as the value), filled by
                               wwwroot/js/typology-inspector.js fillBuildingTypologyRows; a single "Not classified"
                               row when the building has no path (issue #31). *@
                            <div id="typology-building-typology"></div>
                        </dl>
                        <div class="typology-building-links">
                            <a id="typology-building-details" class="gis-button" target="_blank" rel="noopener">Details</a>
                            <a id="typology-building-model" class="gis-button" target="_blank" rel="noopener" hidden>3D Viewer</a>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    @* Classic scripts (no module imports), loaded after the page body so the targets they wire exist, in
       dependency order: the shared helpers, the shell (resizers and toggles), the three renderers (panel,
       map, inspector), then the view script whose solve bootstrap calls all three. *@
    <script src="~/js/typology-common.js" asp-append-version="true"></script>
    <script src="~/js/typology-layout.js" asp-append-version="true"></script>
    <script src="~/js/typology-panel.js" asp-append-version="true"></script>
    <script src="~/js/typology-map.js" asp-append-version="true"></script>
    <script src="~/js/typology-inspector.js" asp-append-version="true"></script>
    <script src="~/js/typology-view.js" asp-append-version="true"></script>
}
