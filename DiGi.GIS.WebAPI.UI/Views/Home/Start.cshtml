@{
    ViewData["Title"] = "Main Menu";
    ViewData["Description"] = "Access the main navigation for the DigiProject GIS Web application, including administrative areas and building search by address.";

    // Whether a session is being shown, the _Layout.cshtml check: the Orto Data entry is a signed-in
    // feature, so it is rendered only for a visitor who has one.
    bool ortodataSignedIn = Context.Request.Cookies.ContainsKey(DiGi.GIS.WebAPI.UI.Constants.Default.UserTokenCookieName);
}

<div class="gis-home-container">
    <div class="button-container">
        <button class="gis-menu-btn" onclick="window.location.href='@Url.Content("~/administrativeareal2D")'">
            Administrative Areas
        </button>
        <button class="gis-menu-btn" onclick="window.location.href='@Url.Content("~/building2D")'">
            Buildings
        </button>
        @if (ortodataSignedIn)
        {
            <button class="gis-menu-btn" onclick="window.location.href='@Url.Content("~/ortodata")'">
                Orto Data
            </button>
        }
        <button class="gis-menu-btn" onclick="window.location.href='@Url.Content("~/communication")'">
            Communication
        </button>
        <button class="gis-menu-btn" onclick="window.location.href='@Url.Content("~/buildingmodel")'">
            3D Viewer
        </button>
        <button class="gis-menu-btn" onclick="window.location.href='@Url.Content("~/terrain")'">
            Terrain
        </button>
        <button class="gis-menu-btn" onclick="window.location.href='@Url.Content("~/typology")'">
            Typology
        </button>
        <button class="gis-menu-btn" onclick="window.location.href='@Url.Content("~/about")'">
            About
        </button>
    </div>
</div>
