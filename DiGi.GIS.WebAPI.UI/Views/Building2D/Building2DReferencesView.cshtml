@using DiGi.GIS.WebAPI.UI.ViewModels

@model Building2DReferencesViewModel

@{
    ViewData["Title"] = "Buildings";
    ViewData["Description"] = "Browse and query building details from the GIS database.";
}

<div class="master-detail-wrapper">
    @* LEWA STRONA: LISTA *@
    <div id="listSide">
        @* Renderujemy listę budynków z partiala *@
        @await Html.PartialAsync("_Building2DReferences", Model.Building2DReferences)
    </div>

    @* PRAWA STRONA: DETALE *@
    <div id="detailsSide">
        <div id="detailsLoader" class="details-loader">
            <div class="gis-loader"></div>
            <p class="gis-loader-text">Fetching data...</p>
        </div>

        <div id="detailsContent">
            <div class="gis-placeholder">
                <i class="gis-placeholder-icon">🏢</i>
                <p>Select a building from the list to view its technical details and location.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/gis-common.js" asp-append-version="true"></script>
    <script src="~/js/building.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initBuildingReferencesView();
        });
    </script>
}
